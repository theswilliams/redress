DATABASE_URL="file:./dev.db"

# Auth.js — generate a real secret for production: `npx auth secret`
AUTH_SECRET=""

# Google Gemini API key for the AI analysis pipeline (server-side only, never expose to the client)
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Business model config — see src/lib/billing/config.ts. Not hard-coded into the app logic.
REDRESS_SUCCESS_FEE_PERCENT="25"

# Local object storage root (swappable for S3-compatible storage later)
STORAGE_ROOT="./storage/uploads"
