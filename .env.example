# Postgres connection string (Vercel Postgres / Neon). Get one from your
# Vercel project's Storage tab (Create Database -> Postgres) — it injects
# DATABASE_URL automatically for deployed environments. For local dev, copy
# that same connection string here, or create a separate Neon branch.
DATABASE_URL=""

# Auth.js — generate a real secret: `npx auth secret` (or `openssl rand -base64 32`)
AUTH_SECRET=""

# Google Gemini API key for the AI analysis pipeline (server-side only, never expose to the client)
# Free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Resend API key for sending approved claim emails (server-side only)
# Free tier, no card required: https://resend.com/api-keys
# Without a key, approved submissions are simulated (clearly labeled) instead of sent.
RESEND_API_KEY=""

# Sender address for outgoing claim emails. The default sandbox sender only
# delivers to the Resend account owner's own email until a custom domain is
# verified — see https://resend.com/docs/dashboard/domains/introduction
EMAIL_FROM="Redress <onboarding@resend.dev>"

# Vercel Blob storage token — from your Vercel project's Storage tab (Create
# -> Blob), auto-injected in deployed environments. Without it, uploads fall
# back to the local filesystem, which only works for local dev — it does NOT
# work when deployed to Vercel (serverless functions have a read-only
# filesystem outside /tmp, wiped between invocations).
BLOB_READ_WRITE_TOKEN=""

# Local object storage root, only used when BLOB_READ_WRITE_TOKEN is unset.
STORAGE_ROOT="./storage/uploads"

# Upstash Redis — from your Vercel project's Storage tab (Create -> Marketplace
# Database Providers -> Upstash), auto-injected in deployed environments.
# REQUIRED in production: without it, rate limiting falls back to in-memory
# state, which does not work on Vercel (serverless functions don't share
# memory across invocations), so requests are effectively unlimited.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public base URL used in emailed links (password reset, verification). On Vercel it falls back to
# the project's production URL (VERCEL_PROJECT_PRODUCTION_URL); set it for any other host.
APP_URL=""

# Secret for the daily demo reset (GET /api/cron/reset-demo, scheduled in vercel.json). Vercel sends
# it as "Authorization: Bearer <secret>". Without it the reset endpoint refuses to run.
CRON_SECRET=""

# Optional: pin a specific Gemini model (default: gemini-flash-latest).
GEMINI_MODEL=""

# Max AI analyses one account may start per rolling 24 hours (default 20). Bounds cost abuse per account.
AI_MAX_ANALYSES_PER_DAY=""
